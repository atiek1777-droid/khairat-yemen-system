# ============================================
# معامل خيرات اليمن - متغيرات البيئة
# انسخ هذا الملف إلى .env.local وضع القيم الحقيقية
# لا تقم أبداً بحفظ القيم الحقيقية في هذا الملف أو في المستودع
# ============================================

# رابط مشروع Supabase (Settings -> API -> Project URL)
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co

# المفتاح العام Anon Key (Settings -> API -> anon public)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# اسم التطبيق (اختياري - يستخدم في العنوان والميتاداتا)
NEXT_PUBLIC_APP_NAME="معامل خيرات اليمن"

# رقم واتساب المصنع الافتراضي لمشاركة التقارير (بصيغة دولية بدون +)
NEXT_PUBLIC_FACTORY_WHATSAPP=967784355755

# ============================================
# سري جداً - Server-side only. لا تضعه أبداً في كود الواجهة الأمامية
# مطلوب فقط لعمليات إدارة المستخدمين (إنشاء / إعادة تعيين كلمة المرور)
# Settings -> API -> service_role key
# ============================================
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here
